# ===========================================================================
# DrugScope - copy to `.env` and set ONE provider key. Nothing else is needed.
#   Windows:  copy .env.example .env      macOS/Linux:  cp .env.example .env
# ===========================================================================

# --- 1. PICK ONE. The app auto-selects whichever provider has a key. -------

# Option A - OpenRouter. Gateway to many models, including free ones.
# A `:free` model costs nothing but is capped per minute AND per day, so
# DrugScope appraises records in batches and skips the web sweep. The sidebar
# lists the free models OpenRouter serves right now - they change often.
#OPENROUTER_API_KEY=sk-or-v1-...
#OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Option B - Anthropic / Claude. Full capability: one appraisal call per
# record, adaptive thinking, and server-side web search for recent developments.
#ANTHROPIC_API_KEY=sk-ant-...

# Option C - OpenAI / GPT
#OPENAI_API_KEY=sk-proj-...

# A key in this file wins over one set elsewhere on your machine. To force a
# provider when several keys exist: DRUGSCOPE_PROVIDER=openrouter|anthropic|openai
# The model is also switchable in the sidebar under "Model".


# --- 2. OPTIONAL. Everything below can stay blank. -------------------------

# NOT REQUIRED. Every research database DrugScope queries is open and keyless:
# Europe PMC, PubMed, ClinicalTrials.gov, Drugs@FDA, FDA labels, FAERS,
# FDA enforcement, ChEMBL, RxNorm.
# An NCBI key only lifts the PubMed rate limit from ~3 to ~10 req/sec. Without
# it PubMed still works, and Europe PMC covers the literature stream anyway.
NCBI_API_KEY=
NCBI_EMAIL=

# --- 3. COMMUNITY, ACCOUNTS AND QUOTAS ---------------------------------------

# The administrator account (moderation, exports, plans). Created or refreshed
# from these values every time the app starts; nobody can sign up with this
# username. Use a long random password and keep this file private.
#DRUGSCOPE_ADMIN_USERNAME=admin
#DRUGSCOPE_ADMIN_PASSWORD=use-a-long-random-password

# Research credits per rolling window. Scan costs 1, Standard 2, Deep 4.
#DRUGSCOPE_FREE_CREDITS=5
#DRUGSCOPE_PRO_CREDITS=60
#DRUGSCOPE_TEAM_CREDITS=200
#DRUGSCOPE_QUOTA_WINDOW_HOURS=24

# Prices shown on the Plans & access page (display only).
#DRUGSCOPE_PRO_PRICE=$9
#DRUGSCOPE_TEAM_PRICE=$29

# Optional checkout links for the "Upgrade" buttons (e.g. Stripe Payment Links).
# Without them the page says checkout is not connected. After payment, the
# administrator issues an upgrade code in Admin console -> Users & plans.
#DRUGSCOPE_UPGRADE_URL=https://buy.stripe.com/your-pro-link
#DRUGSCOPE_UPGRADE_URL_TEAM=https://buy.stripe.com/your-team-link

# Free-text report context is cleared after this many days (0 = keep).
#DRUGSCOPE_CONTEXT_RETENTION_DAYS=365

# Where the research database lives (default: data/drugscope.db).
#DRUGSCOPE_DB_PATH=data/drugscope.db


# Per-stage Claude model overrides (Anthropic only - for OpenRouter models use
# OPENROUTER_MODEL above).
#DRUGSCOPE_SYNTHESIS_MODEL=claude-opus-5-5
#DRUGSCOPE_PLANNING_MODEL=claude-opus-5-5
#DRUGSCOPE_EXTRACTION_MODEL=claude-sonnet-5-5

# Community reports go public immediately (1, default) or wait for admin approval (0).
#DRUGSCOPE_AUTO_APPROVE=1
